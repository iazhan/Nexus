{
  "name": "@nexus/desktop",
  "version": "0.68.0",
  "private": true,
  "description": "Nexus — local-first Markdown knowledge base",
  "author": "iazhan",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "predev": "pnpm --filter @nexus/core build && pnpm --filter @nexus/theme build && pnpm --filter @nexus/i18n build && pnpm --filter @nexus/command build && pnpm --filter @nexus/editor build && node ../../packages/theme/scripts/generate-css.mjs && node ../../scripts/copy-pdfjs-assets.mjs",
    "dev": "electron-vite dev",
    "prebuild": "pnpm --filter @nexus/core build && pnpm --filter @nexus/theme build && pnpm --filter @nexus/i18n build && pnpm --filter @nexus/command build && pnpm --filter @nexus/editor build && node ../../packages/theme/scripts/generate-css.mjs && node ../../scripts/copy-pdfjs-assets.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "vitest run test/desktop-smoke.test.ts",
    "pack:dir": "electron-builder --dir --publish never",
    "pack:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "node-sqlite3-wasm": "^0.8.60",
    "pdfjs-dist": "4.10.38",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nexus/command": "workspace:*",
    "@nexus/core": "workspace:*",
    "@nexus/editor": "workspace:*",
    "@nexus/i18n": "workspace:*",
    "@nexus/math": "workspace:*",
    "@nexus/mermaid": "workspace:*",
    "@nexus/theme": "workspace:*",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
