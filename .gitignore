# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
out/
build/
*.tsbuildinfo

# pdfjs 静态资源（cmaps / standard_fonts，185 个二进制文件）
# 由 scripts/copy-pdfjs-assets.mjs 从 node_modules/pdfjs-dist 复制，挂在 predev / prebuild 上。
# 不进版本库：可以从依赖完整重建，而 185 个 .bcmap 进 diff 只会淹没真正的改动。
apps/desktop/renderer/public/pdfjs/

# 内置主题的静态 CSS：由 packages/theme/scripts/generate-css.mjs 生成，挂在 predev / prebuild 上。
# 不进版本库：可以从 BUILT_IN_THEMES 完整重建，而 84 行声明进 diff 只会淹没真正的改动。
apps/desktop/renderer/public/theme.css

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local configs
.env
.env.local
.env.*.local

# Editor and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# vite / vitest / electron-vite 加载 TS 配置时写的临时文件。
# 正常会自己删掉，但进程被强杀（或批跑脚本超时 kill）时会残留 ——
# 落进工作区后 `git status` 里会多出一堆看不懂的文件。
*.timestamp-*.mjs
electron.vite.config.*.mjs

# Development documents
docs/

# 仓库根的临时验证样本：手工拷出来的草稿，不进版本库
code-blocks-showcase.md

# 仓库根的临时验证产物：构建 / 测试日志与探针输出，不进版本库
tmp/

# Local agent instructions
AGENTS.md

# Local agent workspace data
.workbuddy-ai/
